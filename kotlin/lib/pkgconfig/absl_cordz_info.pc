prefix=/data/data/com.termux/files/usr
exec_prefix=${prefix}
libdir=/data/data/com.termux/files/usr/lib
includedir=/data/data/com.termux/files/usr/include

Name: absl_cordz_info
Description: Abseil cordz_info library
URL: https://abseil.io/
Version: 20260526
Requires: absl_base = 20260526, absl_config = 20260526, absl_cord_internal = 20260526, absl_cordz_functions = 20260526, absl_cordz_handle = 20260526, absl_cordz_statistics = 20260526, absl_cordz_update_tracker = 20260526, absl_core_headers = 20260526, absl_no_destructor = 20260526, absl_inlined_vector = 20260526, absl_span = 20260526, absl_raw_logging_internal = 20260526, absl_stacktrace = 20260526, absl_synchronization = 20260526, absl_time = 20260526
Libs: -L${libdir}  -labsl_cordz_info 
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -Wno-unused-command-line-argument -DNOMINMAX
