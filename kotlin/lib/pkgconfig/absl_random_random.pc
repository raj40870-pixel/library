prefix=/data/data/com.termux/files/usr
exec_prefix=${prefix}
libdir=/data/data/com.termux/files/usr/lib
includedir=/data/data/com.termux/files/usr/include

Name: absl_random_random
Description: Abseil random_random library
URL: https://abseil.io/
Version: 20260526
Requires: absl_config = 20260526, absl_random_distributions = 20260526, absl_random_internal_nonsecure_base = 20260526, absl_random_internal_pcg_engine = 20260526, absl_random_internal_randen_engine = 20260526, absl_random_seed_sequences = 20260526
Libs: -L${libdir}  
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -Wno-unused-command-line-argument -DNOMINMAX
