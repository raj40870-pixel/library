prefix=/data/data/com.termux/files/usr
exec_prefix=${prefix}
libdir=/data/data/com.termux/files/usr/lib
includedir=/data/data/com.termux/files/usr/include

Name: absl_random_seed_sequences
Description: Abseil random_seed_sequences library
URL: https://abseil.io/
Version: 20260526
Requires: absl_config = 20260526, absl_inlined_vector = 20260526, absl_nullability = 20260526, absl_random_internal_entropy_pool = 20260526, absl_random_internal_salted_seed_seq = 20260526, absl_random_internal_seed_material = 20260526, absl_random_seed_gen_exception = 20260526, absl_span = 20260526, absl_string_view = 20260526
Libs: -L${libdir}  -labsl_random_seed_sequences 
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -Wno-unused-command-line-argument -DNOMINMAX
