prefix=/data/data/com.termux/files/usr
exec_prefix=${prefix}
libdir=/data/data/com.termux/files/usr/lib
includedir=/data/data/com.termux/files/usr/include

Name: absl_status_builder
Description: Abseil status_builder library
URL: https://abseil.io/
Version: 20260526
Requires: absl_config = 20260526, absl_cord = 20260526, absl_core_headers = 20260526, absl_nullability = 20260526, absl_optional = 20260526, absl_source_location = 20260526, absl_span = 20260526, absl_status = 20260526, absl_strings = 20260526, absl_time = 20260526
Libs: -L${libdir}  -labsl_status_builder 
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -Wno-unused-command-line-argument -DNOMINMAX
