prefix=/data/data/com.termux/files/usr
exec_prefix=${prefix}
libdir=/data/data/com.termux/files/usr/lib
includedir=/data/data/com.termux/files/usr/include

Name: absl_flags
Description: Abseil flags library
URL: https://abseil.io/
Version: 20260526
Requires: absl_config = 20260526, absl_flags_commandlineflag = 20260526, absl_flags_config = 20260526, absl_flags_internal = 20260526, absl_flags_reflection = 20260526, absl_core_headers = 20260526, absl_nullability = 20260526, absl_strings = 20260526
Libs: -L${libdir}  
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -Wno-unused-command-line-argument -DNOMINMAX
