prefix=/data/data/com.termux/files/usr
exec_prefix=${prefix}
libdir=/data/data/com.termux/files/usr/lib
includedir=/data/data/com.termux/files/usr/include

Name: absl_raw_hash_map
Description: Abseil raw_hash_map library
URL: https://abseil.io/
Version: 20260526
Requires: absl_config = 20260526, absl_common_policy_traits = 20260526, absl_container_memory = 20260526, absl_core_headers = 20260526, absl_raw_hash_set = 20260526, absl_type_traits = 20260526, absl_throw_delegate = 20260526
Libs: -L${libdir}  
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -Wno-unused-command-line-argument -DNOMINMAX
