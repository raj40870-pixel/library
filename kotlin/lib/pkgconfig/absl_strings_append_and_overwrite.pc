prefix=/data/data/com.termux/files/usr
exec_prefix=${prefix}
libdir=/data/data/com.termux/files/usr/lib
includedir=/data/data/com.termux/files/usr/include

Name: absl_strings_append_and_overwrite
Description: Abseil strings_append_and_overwrite library
URL: https://abseil.io/
Version: 20260526
Requires: absl_config = 20260526, absl_core_headers = 20260526, absl_hardening = 20260526, absl_strings_resize_and_overwrite = 20260526, absl_throw_delegate = 20260526
Libs: -L${libdir}  
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -Wno-unused-command-line-argument -DNOMINMAX
