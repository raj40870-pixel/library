prefix=/data/data/com.termux/files/usr
exec_prefix=${prefix}
libdir=/data/data/com.termux/files/usr/lib
includedir=/data/data/com.termux/files/usr/include

Name: absl_crc_internal
Description: Abseil crc_internal library
URL: https://abseil.io/
Version: 20260526
Requires: absl_crc_cpu_detect = 20260526, absl_bits = 20260526, absl_config = 20260526, absl_core_headers = 20260526, absl_endian = 20260526, absl_memory = 20260526, absl_prefetch = 20260526, absl_raw_logging_internal = 20260526
Libs: -L${libdir}  -labsl_crc_internal 
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -Wno-unused-command-line-argument -DNOMINMAX
