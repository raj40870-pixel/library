prefix=/data/data/com.termux/files/usr
exec_prefix=${prefix}
libdir=/data/data/com.termux/files/usr/lib
includedir=/data/data/com.termux/files/usr/include

Name: absl_flags_reflection
Description: Abseil flags_reflection library
URL: https://abseil.io/
Version: 20260526
Requires: absl_config = 20260526, absl_fast_type_id = 20260526, absl_flags_commandlineflag = 20260526, absl_flags_private_handle_accessor = 20260526, absl_flags_config = 20260526, absl_strings = 20260526, absl_synchronization = 20260526, absl_flat_hash_map = 20260526, absl_no_destructor = 20260526
Libs: -L${libdir}  -labsl_flags_reflection 
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -Wno-unused-command-line-argument -DNOMINMAX
