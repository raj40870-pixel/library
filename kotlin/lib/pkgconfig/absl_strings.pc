prefix=/data/data/com.termux/files/usr
exec_prefix=${prefix}
libdir=/data/data/com.termux/files/usr/lib
includedir=/data/data/com.termux/files/usr/include

Name: absl_strings
Description: Abseil strings library
URL: https://abseil.io/
Version: 20260526
Requires: absl_string_view = 20260526, absl_strings_append_and_overwrite = 20260526, absl_strings_internal = 20260526, absl_strings_resize_and_overwrite = 20260526, absl_base = 20260526, absl_bits = 20260526, absl_charset = 20260526, absl_config = 20260526, absl_core_headers = 20260526, absl_endian = 20260526, absl_hardening = 20260526, absl_int128 = 20260526, absl_iterator_traits_internal = 20260526, absl_memory = 20260526, absl_nullability = 20260526, absl_raw_logging_internal = 20260526, absl_source_location = 20260526, absl_strings = 20260526, absl_throw_delegate = 20260526, absl_type_traits = 20260526
Libs: -L${libdir}  -labsl_strings 
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -Wno-unused-command-line-argument -DNOMINMAX
