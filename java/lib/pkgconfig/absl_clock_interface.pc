prefix=/data/data/com.termux/files/usr
exec_prefix=${prefix}
libdir=/data/data/com.termux/files/usr/lib
includedir=/data/data/com.termux/files/usr/include

Name: absl_clock_interface
Description: Abseil clock_interface library
URL: https://abseil.io/
Version: 20260526
Requires: absl_time = 20260526, absl_config = 20260526, absl_core_headers = 20260526, absl_no_destructor = 20260526, absl_nullability = 20260526, absl_raw_logging_internal = 20260526, absl_synchronization = 20260526
Libs: -L${libdir}  -labsl_clock_interface 
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -Wno-unused-command-line-argument -DNOMINMAX
