prefix=/data/data/com.termux/files/usr
exec_prefix=${prefix}
libdir=/data/data/com.termux/files/usr/lib
includedir=/data/data/com.termux/files/usr/include

Name: absl_cord_internal
Description: Abseil cord_internal library
URL: https://abseil.io/
Version: 20260526
Requires: absl_compressed_tuple = 20260526, absl_config = 20260526, absl_container_memory = 20260526, absl_compare = 20260526, absl_core_headers = 20260526, absl_crc_cord_state = 20260526, absl_endian = 20260526, absl_inlined_vector = 20260526, absl_layout = 20260526, absl_raw_logging_internal = 20260526, absl_strings = 20260526, absl_throw_delegate = 20260526, absl_type_traits = 20260526
Libs: -L${libdir}  -labsl_cord_internal 
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -Wno-unused-command-line-argument -DNOMINMAX
