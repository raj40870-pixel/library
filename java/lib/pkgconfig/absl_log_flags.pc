prefix=/data/data/com.termux/files/usr
exec_prefix=${prefix}
libdir=/data/data/com.termux/files/usr/lib
includedir=/data/data/com.termux/files/usr/include

Name: absl_log_flags
Description: Abseil log_flags library
URL: https://abseil.io/
Version: 20260526
Requires: absl_config = 20260526, absl_core_headers = 20260526, absl_log_globals = 20260526, absl_log_severity = 20260526, absl_log_internal_config = 20260526, absl_log_internal_flags = 20260526, absl_flags = 20260526, absl_flags_marshalling = 20260526, absl_strings = 20260526, absl_vlog_config_internal = 20260526
Libs: -L${libdir}  -labsl_log_flags 
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -Wno-unused-command-line-argument -DNOMINMAX
