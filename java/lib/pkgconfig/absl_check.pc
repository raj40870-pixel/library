prefix=/data/data/com.termux/files/usr
exec_prefix=${prefix}
libdir=/data/data/com.termux/files/usr/lib
includedir=/data/data/com.termux/files/usr/include

Name: absl_check
Description: Abseil check library
URL: https://abseil.io/
Version: 20260526
Requires: absl_log_internal_check_impl = 20260526, absl_core_headers = 20260526, absl_log_internal_check_op = 20260526, absl_log_internal_conditions = 20260526, absl_log_internal_message = 20260526, absl_log_internal_strip = 20260526
Libs: -L${libdir}  
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -Wno-unused-command-line-argument -DNOMINMAX
