prefix=/data/data/com.termux/files/usr
exec_prefix=${prefix}
libdir=/data/data/com.termux/files/usr/lib
includedir=/data/data/com.termux/files/usr/include

Name: absl_hashtablez_sampler
Description: Abseil hashtablez_sampler library
URL: https://abseil.io/
Version: 20260526
Requires: absl_base = 20260526, absl_config = 20260526, absl_exponential_biased = 20260526, absl_no_destructor = 20260526, absl_raw_logging_internal = 20260526, absl_sample_recorder = 20260526, absl_synchronization = 20260526, absl_time = 20260526
Libs: -L${libdir}  -labsl_hashtablez_sampler 
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -Wno-unused-command-line-argument -DNOMINMAX
