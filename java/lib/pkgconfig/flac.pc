prefix=/data/data/com.termux/files/usr
exec_prefix=${prefix}
libdir=/data/data/com.termux/files/usr/lib
includedir=/data/data/com.termux/files/usr/include

Name: FLAC
Description: Free Lossless Audio Codec Library
Version: 1.5.0
Requires.private: ogg
Libs: -L${libdir} -lFLAC
Libs.private: -lm 
Cflags: -I${includedir}
